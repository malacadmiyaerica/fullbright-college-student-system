# Fullbright College - Student Management System
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_ENV=production

# Public URL used in Digital ID QR codes and share links. Leave empty to
# auto-detect from the incoming request (works on any domain). Set this when
# behind a proxy or when you want a canonical URL.
# FULLBRIGHT_PUBLIC_URL=https://fullbright-college.example

# ------------------------------------------------------------------
# Database (choose ONE style)
# ------------------------------------------------------------------
# Option A - single connection URL (Railway/Render/Fly/Heroku provide this):
# DATABASE_URL=mysql://user:password@host:3306/fullbright_college

# Option B - individual settings:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fullbright_college
DB_USER=root
DB_PASS=

# Require TLS for managed MySQL on a public endpoint:
# DB_SSL=true
# DB_SSL_CA=/path/to/ca.pem

# ------------------------------------------------------------------
# Sessions
# ------------------------------------------------------------------
# database = store sessions in MySQL (recommended for containers/instances).
# files    = default PHP file-based sessions.
SESSION_DRIVER=files

# ------------------------------------------------------------------
# One-time schema import (containers only; destructive, fresh DBs only)
# ------------------------------------------------------------------
# AUTO_IMPORT_SCHEMA=true

# ------------------------------------------------------------------
# Email delivery (optional). Without SMTP_HOST the app falls back to mail().
# ------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-smtp-password
# SMTP_ENCRYPTION=tls
MAIL_FROM=noreply@fullbrightcollege.example
MAIL_FROM_NAME=Fullbright College Student Portal

# On-screen fallbacks (set to false once SMTP delivery is configured):
# SHOW_CREDENTIALS_ONSCREEN=false
# SHOW_VERIFICATION_LINK_ONSCREEN=false
